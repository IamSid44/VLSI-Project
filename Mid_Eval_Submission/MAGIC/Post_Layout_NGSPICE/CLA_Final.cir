VA3 A3 gnd 0
VA2 A2 gnd 0
VA1 A1 gnd 0
VA0 A0 gnd 0

VB3 B3 gnd 0
VB2 B2 gnd 'SUPPLY'
VB1 B1 gnd 'SUPPLY'
VB0 B0 gnd pulse 0 'SUPPLY' 0 0 0 1ns 2ns

VCin Cin gnd 'SUPPLY'

.measure tran trise
+ TRIG V(S3) VAL = 'SUPPLY / 10' RISE = 1
+ TARG V(S3) VAL = '9 * SUPPLY / 10' RISE = 1

.measure tran tfall
+ TRIG V(S3) VAL = '9 * SUPPLY / 10' FALL = 1
+ TARG V(S3) VAL = 'SUPPLY / 10' FALL = 1

.measure tran delay param = '(trise + tfall) / 2'

.measure tran tpdrise
+ TRIG V(B0) VAL = 'SUPPLY / 2' RISE = 1
+ TARG V(S3) VAL = 'SUPPLY / 2' RISE = 1

.measure tran tpdfall
+ TRIG V(B0) VAL = 'SUPPLY / 2' FALL = 1
+ TARG V(S3) VAL = 'SUPPLY / 2' FALL = 1

.measure tran tpd param = '(tpdrise + tpdfall) / 2'

.tran 1p 5n

.control

run
set hcopypscolor = 1
set color0 = white
set color1 = black
set curplottitle = "Siddarth Gottumukkula 2023102040"
set xbrushwidth = 3

* 10010 Output

let in_A3 = 'A3 + 26'
let in_A2 = 'A2 + 24'
let in_A1 = 'A1 + 22'
let in_A0 = 'A0 + 20'

let in_B3 = 'B3 + 18'
let in_B2 = 'B2 + 16'
let in_B1 = 'B1 + 14'
let in_B0 = 'B0 + 12'

let in_Cin = 'Cin + 10'

let out_Cout = 'C3 + 8'
let out_S3 = 'S3 + 6'
let out_S2 = 'S2 + 4'
let out_S1 = 'S1 + 2'
let out_S0 = 'S0'

* plot in_A3 in_A2 in_A1 in_A0 in_B3 in_B2 in_B1 in_B0 in_Cin out_Cout out_S3 out_S2 out_S1 out_S0
* plot in_A3 in_A2 in_A1 in_A0 in_B3 in_B2 in_B1 in_B0
plot out_Cout out_S3 out_S2 out_S1 out_S0
* plot Inter_S0 Inter_S1+2 Inter_S2+4 Inter_S3+6
* plot P0_Not   P1_Not+2 P2_Not+4 P3_Not+6
* plot G0_Not G1_Not+2 G2_Not+4 G3_Not+6
* plot C1_inter_NAND + 4 C1_inter_01 + 2 Intermediate
let curr = (-Vdd#branch)
plot curr

.endc

.end