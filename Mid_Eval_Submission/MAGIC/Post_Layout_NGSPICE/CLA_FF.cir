.param T_Period = 0.84n ; 1.19 GHz
.param T_Period_half = {T_Period * 0.5}
.param T_Period_Double = {T_Period * 2}

VClk clk gnd pulse 0 SUPPLY 0 50p 50p T_Period_half T_Period

VA3 A3 gnd 0
VA2 A2 gnd 0
VA1 A1 gnd 0
VA0 A0 gnd 0

VB3 B3 gnd 0
VB2 B2 gnd 'SUPPLY'
VB1 B1 gnd 'SUPPLY'
* VB0 B0 gnd 'SUPPLY'
VB0 B0 gnd pulse 0 'SUPPLY' 0 50p 50p T_Period T_Period_Double

VCin Cin gnd 'SUPPLY'

.tran 10p 5n

.ic V(C_out_FF) = 0
.ic V(S3_FF) = 0
.ic V(S2_FF) = 0
.ic V(S1_FF) = 0
.ic V(S0_FF) = 0
.ic V(FA0) = 0
.ic V(FA1) = 0
.ic V(FA2) = 0
.ic V(FA3) = 0
.ic V(FB0) = 0
.ic V(FB1) = 0
.ic V(FB2) = 0
.ic V(FB3) = 0
.ic V(FCin) = 0

.control

run
set hcopypscolor = 1
set color0 = white
set color1 = black
set curplottitle = "Siddarth Gottumukkula 2023102040"
set xbrushwidth = 3

let clock = 'clk + 28'

let in_A3 = 'A3 + 26'
let in_A2 = 'A2 + 24'
let in_A1 = 'A1 + 22'
let in_A0 = 'A0 + 20'

let in_B3 = 'B3 + 18'
let in_B2 = 'B2 + 16'
let in_B1 = 'B1 + 14'
let in_B0 = 'B0  + 12'

let in_Cin = 'Cin + 10'

let out_Cout = 'C_out_FF + 8'
let out_S3 = 'S3_FF + 6'
let out_S2 = 'S2_FF + 4'
let out_S1 = 'S1_FF + 2'
let out_S0 = 'S0_FF'

* plot clock in_A3 in_A2 in_A1 in_A0 in_B3 in_B2 in_B1 in_B0 in_Cin
plot out_Cout out_S3 out_S2 out_S1 out_S0
* plot clock out_Cout out_S3 out_S2 out_S1 out_S0

.endc

.end